# Single-server deployment: core and edge behind one nginx.
#
#   app.${DOMAIN}    Mini App static files
#   admin.${DOMAIN}  admin panel static files + /admin/ API
#   api.${DOMAIN}    REST for the Mini App
#   cdn.${DOMAIN}    audio streaming, with the same LRU cache the split edge uses
#   hook.${DOMAIN}   Telegram webhook ingress
#
# The split deployment (core.conf.template + edge.conf.template) keeps these on two
# machines and reaches the core over WireGuard. Here everything is one hop away, so
# the webhook goes straight to the API and there is no internal :8080 listener to
# publish. Everything else — TLS, caching, rate limits, the CSP — is the same.

proxy_cache_path /var/cache/nginx/stream levels=1:2 keys_zone=stream:200m
                 max_size=${EDGE_CACHE_SIZE} inactive=7d use_temp_path=off;
limit_req_zone $binary_remote_addr zone=api_per_ip:20m rate=20r/s;
limit_req_zone $binary_remote_addr zone=stream_per_ip:20m rate=30r/s;
limit_req_zone $binary_remote_addr zone=hook_per_ip:10m rate=50r/s;

# Docker's embedded DNS, re-checked every 10s. Without this nginx would keep the
# IP a container had when nginx started, and `compose up -d api` (which is what
# changing .env forces) would answer 502 until someone reloaded nginx.
resolver 127.0.0.11 ipv6=off valid=10s;

# Whether a stream came from the cache or from Telegram is the single most useful
# number when playback feels slow, and the header alone cannot be counted. One
# grep -c HIT over this log answers it.
log_format stream_cache '$time_iso8601 $upstream_cache_status $request_uri '
                        '$status $body_bytes_sent $request_time';

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:20m;
ssl_session_timeout 1d;
server_tokens off;
gzip on;
gzip_types application/json text/css application/javascript image/svg+xml;

# Port 80 stays open for ACME renewals; everything else is redirected.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name api.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    # Never exposed publicly, even on one machine.
    location ~ ^/(internal|metrics|docs|openapi.json) { return 404; }

    set $api_upstream api:8000;

    location / {
        limit_req zone=api_per_ip burst=60 nodelay;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    root /srv/miniapp;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.${DOMAIN} https://i.scdn.co; media-src https://cdn.${DOMAIN}; connect-src 'self' https://api.${DOMAIN}; font-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org" always;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    root /srv/web;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.${DOMAIN} https://cdn2.${DOMAIN} blob:; media-src https://cdn.${DOMAIN} https://cdn2.${DOMAIN} blob:; connect-src 'self' https://api.${DOMAIN} https://${DOMAIN}; font-src 'self'; frame-src 'self' https://oauth.telegram.org; frame-ancestors 'self'; base-uri 'none'; form-action 'self'" always;

    # Same-origin proxy for the Login Widget JS — telegram.org is filtered in Iran.
    # Variable + resolver defers DNS to request time so nginx starts even if
    # Telegram DNS is slow/unreachable at boot; otherwise `proxy_pass https://...`
    # would fail `nginx -t` and the container would loop in Restarting.
    location = /telegram-widget.js {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $tg_widget https://telegram.org/js/telegram-widget.js;
        proxy_pass $tg_widget;
        proxy_ssl_server_name on;
        proxy_set_header Host telegram.org;
        proxy_cache off;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # OAuth popup — TWidgetLogin.auth() opens window.open('/auth?bot_id=...').
    # When the widget JS is proxied same-origin, that URL resolves to
    # https://$host/auth and would otherwise hit the SPA's try_files.
    location ~ ^/auth(/|$) {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $oauth_auth https://oauth.telegram.org;
        proxy_pass $oauth_auth$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host oauth.telegram.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Accept-Encoding "";
        proxy_cache off;
        proxy_buffering off;
        sub_filter 'https://telegram.org/' 'https://$host/';
        sub_filter_once off;
        sub_filter_types text/html text/css application/javascript;
        expires -1;
        add_header Cache-Control "no-store" always;
    }

    # Proxy for the Login Widget iframe — the widget JS sets its iframe src to
    # location.origin + /embed/... when loaded from a same-origin proxy (see
    # telegram-widget.js:getWidgetsOrigin). Without this, /embed/* falls through
    # to the SPA's index.html and the button is invisible. Proxying here also
    # bypasses the same Iran filter that the JS proxy was added for.
    location ~ ^/embed/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $oauth_base https://oauth.telegram.org;
        proxy_pass $oauth_base$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host oauth.telegram.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Accept-Encoding "";
        proxy_cache off;
        # Rewrite absolute telegram.org asset URLs inside the HTML to same-origin
        # so the iframe's CSS/JS also bypass the filter when needed.
        sub_filter 'https://telegram.org/' 'https://$host/';
        sub_filter_once off;
        sub_filter_types text/html;
        expires -1;
        add_header Cache-Control "no-store" always;
    }

    # Assets referenced by /embed and /auth (after sub_filter rewrites
    # https://telegram.org/* to https://$host/*). Keep SPA's /assets/ untouched.
    location = /css/oauth-old.css {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $oauth_css https://oauth.telegram.org;
        proxy_pass $oauth_css$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host oauth.telegram.org;
        proxy_set_header Accept-Encoding "";
        proxy_cache off;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
    }
    location ~ ^/css/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $tg_css https://telegram.org;
        proxy_pass $tg_css$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host telegram.org;
        proxy_set_header Accept-Encoding "";
        proxy_cache off;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
    }
    location ~ ^/js/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $tg_js https://telegram.org;
        proxy_pass $tg_js$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host telegram.org;
        proxy_set_header Accept-Encoding "";
        proxy_cache off;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
    }
    location ~ ^/(img|favicon\.ico) {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $tg_img https://telegram.org;
        proxy_pass $tg_img$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host telegram.org;
        proxy_cache off;
        expires 1h;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # Same-origin fallback for API — if api.${DOMAIN} is DNS-filtered, the
    # client retries against https://${DOMAIN}/v1/* via this location.
    set $apex_api api:8000;
    location ^~ /v1/ {
        limit_req zone=api_per_ip burst=60 nodelay;
        proxy_pass http://$apex_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
        client_max_body_size 1m;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    root /srv/admin;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://t.me https://*.telegram.org; connect-src 'self' https://api.${DOMAIN}; font-src 'self'; frame-src https://oauth.telegram.org; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;

    # A second gate in front of the panel is cheap; see RUNBOOK.
    # allow 1.2.3.4; deny all;

    set $api_upstream api:8000;

    location /admin/ {
        limit_req zone=api_per_ip burst=30 nodelay;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name cdn.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    set $edge_upstream edges:8080;
    include /etc/nginx/snippets/stream-cache.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hook.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Telegram's published webhook source ranges.
    allow 149.154.160.0/20;
    allow 91.108.4.0/22;
    deny all;

    location = /tg/webhook {
        limit_req zone=hook_per_ip burst=200 nodelay;
        client_max_body_size 1m;
        # One machine: straight to the API, no tunnel in between.
        set $api_upstream api:8000;
        proxy_pass http://$api_upstream/tg/webhook;
        proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
