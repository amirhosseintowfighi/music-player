# Production core (Iran).
#   api.${DOMAIN}    REST for the Mini App (public, TLS)
#   app.${DOMAIN}    Mini App static files (public, TLS)
#   :8080           internal API, webhook relay target, metrics — compose publishes this
#                   port on the WireGuard address only, so it is unreachable from the internet

limit_req_zone $binary_remote_addr zone=api_per_ip:20m rate=20r/s;

upstream api_app {
    least_conn;
    server api:8000;
    keepalive 64;
}

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:20m;
server_tokens off;
gzip on;
gzip_types application/json text/css application/javascript image/svg+xml;

server {
    listen 80;
    server_name api.${DOMAIN} app.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 1m;

    # Never exposed publicly.
    location ~ ^/(internal|tg|metrics|docs|openapi.json) { return 404; }

    location / {
        limit_req zone=api_per_ip burst=60 nodelay;
        proxy_pass http://api_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    root /srv/miniapp;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.${DOMAIN} https://cdn2.${DOMAIN}; media-src https://cdn.${DOMAIN} https://cdn2.${DOMAIN}; connect-src 'self' https://api.${DOMAIN}; font-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org" always;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

# Admin panel. Separate host so its CSP and access rules never touch the Mini App.
server {
    listen 443 ssl;
    http2 on;
    server_name admin.${DOMAIN};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    root /srv/admin;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # telegram.org is the Login Widget; nothing else may run here.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://t.me https://*.telegram.org; connect-src 'self' https://api.${DOMAIN}; font-src 'self'; frame-src https://oauth.telegram.org; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;

    # Optional second gate in front of the panel; see RUNBOOK.
    # allow 1.2.3.4; deny all;

    location /admin/ {
        limit_req zone=api_per_ip burst=30 nodelay;
        proxy_pass http://api_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}

# Internal listener: edge → core (published on the WireGuard address only).
server {
    listen 8080;
    client_max_body_size 10m;

    location / {
        proxy_pass http://api_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
