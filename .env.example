# ─────────────────────────────────────────────────────────────────────────────
# Environment for local development (docker compose up).
# Production splits this into .env.core (Iran) and .env.edge (abroad); every variable
# below is marked [core], [edge] or [both]. Never commit real values.
# Generate keys/secrets:  docker compose run --rm api python -m app.cli gen-keys
# ─────────────────────────────────────────────────────────────────────────────

# [both] dev | test | prod
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# ── Telegram bot ──────────────────────────────────────────────────────────────
# [both] from @BotFather. The edge needs it for Bot API downloads (never sent to clients).
BOT_TOKEN=123456:replace-me
# [core] without @
BOT_USERNAME=your_bot
# [core] Mini App URL registered with BotFather
WEBAPP_URL=https://app.example.com
# [core] Bot API base. Prod: the edge egress proxy, e.g. http://10.8.0.2:8088
TG_API_BASE=https://api.telegram.org
# [core] public webhook URL (on the edge) and its secret header value
WEBHOOK_URL=https://hook.example.com/tg/webhook
WEBHOOK_SECRET=replace-with-random-32-chars

# ── Auth ──────────────────────────────────────────────────────────────────────
# [core] Ed25519 PEM keys on one line with literal \n (see gen-keys)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace\n-----END PUBLIC KEY-----"
JWT_ISSUER=tmusic
ACCESS_TTL_S=900
REFRESH_TTL_S=2592000
# [core] max age of Mini App initData
AUTH_MAX_AGE_S=86400

# ── Streaming ─────────────────────────────────────────────────────────────────
# [both] comma-separated; first key signs, all verify (rotate by prepending a new key)
STREAM_SIGNING_KEYS=replace-with-random-48-chars
# [core] stream URL lifetime
STREAM_TICKET_TTL_S=300

# ── Core ↔ edge ───────────────────────────────────────────────────────────────
# [both] shared bearer token for /internal (also only reachable over WireGuard)
INTERNAL_API_TOKEN=replace-with-random-48-chars
# [core] address of the edge app over WireGuard; the core calls it to upload a track
# to a user's chat and to read ID3 tags. Empty disables both.
EDGE_INTERNAL_URL=http://10.8.0.2:8081
# [core] above this size the Bot API cannot download a file and MTProto is used instead
BOT_API_MAX_DOWNLOAD=20971520
# [core] crawl lease length and how many channels one worker may hold
INDEXER_LEASE_S=300
INDEXER_CLAIM_LIMIT=20

# ── Monitoring (core) ─────────────────────────────────────────────────────────
# [core] Grafana admin password. Grafana listens on 127.0.0.1 only; reach it over SSH.
GRAFANA_PASSWORD=replace-me
# [core] Alertmanager uses a SEPARATE bot: if the product bot is rate limited, the
# alert still has to get out. Put the token in infra/monitoring/ops_bot_token.

# ── Payments (core) ───────────────────────────────────────────────────────────
# Which gateways are live, and their non-secret settings, live in the payment_providers
# table (admin panel). Only the credentials belong here.
# [core] public base URL of the API; gateways redirect the user back to it
PUBLIC_API_URL=https://api.example.com
# [core] Zarinpal merchant id (UUID from the panel)
ZARINPAL_MERCHANT_ID=
# [core] IDPay API key
IDPAY_API_KEY=
# [core] NextPay API key
NEXTPAY_API_KEY=
# [core] group/channel id where card-to-card receipts are reviewed (0 disables the flow).
# The bot must be a member; add the reviewers to admin_users.
PAYMENTS_ADMIN_CHAT_ID=0

# ── Edge tuning ───────────────────────────────────────────────────────────────
# [edge] what Telegram shows in the account's "active sessions" list
DEVICE_MODEL=tmusic-indexer
# [edge] the stream server binds inside the container; nginx is what faces the world
STREAM_HOST=0.0.0.0
STREAM_PORT=8080
# [edge] how long a resolved message stays cached before it is fetched again
MESSAGE_CACHE_S=1800

# ── Storage (core) ────────────────────────────────────────────────────────────
# Dev compose sets DATABASE_URL/REDIS_URL/MEILI_URL itself; these are for running on the host.
DATABASE_URL=postgresql+asyncpg://tmusic:tmusic@localhost:5432/tmusic
# [core] direct Postgres URL for migrations (prod: bypasses PgBouncer)
MIGRATION_DATABASE_URL=
# [core] true behind PgBouncer (disables server-side prepared statements)
DB_BEHIND_PGBOUNCER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
POSTGRES_PASSWORD=tmusic
# [core, prod] password of the tmusic_app role used through PgBouncer
APP_DB_PASSWORD=replace-me
REDIS_URL=redis://localhost:6379/0
MEILI_URL=http://localhost:7700
# [core] also used as the Meilisearch master key in compose
MEILI_API_KEY=replace-with-random-32-chars
MEILI_INDEX=tracks

# ── HTTP (core) ───────────────────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["https://app.example.com", "https://admin.example.com"]
RATE_LIMIT_USER_PER_MIN=240
RATE_LIMIT_IP_PER_MIN=600

# ── Web-preview crawler (edge) ────────────────────────────────────────────────
# The catalogue comes from public t.me/s/<channel> pages — no Telegram account is
# involved, so these knobs are about politeness, not quota (ADR-002).
CORE_URL=http://api:8000
WORKER_ID=edge-1
CLAIM_INTERVAL_S=10
# how many channels this worker crawls at a time
CRAWL_CLAIM_LIMIT=3
# random pause between page fetches, in seconds
CRAWL_MIN_DELAY_S=1.5
CRAWL_MAX_DELAY_S=4.0
# pages per channel per run; the scheduler resumes from the cursor next time
CRAWL_MAX_PAGES=500
# optional comma-separated http(s) proxies, rotated per request
CRAWL_PROXIES=

# ── Resolver account (edge) ───────────────────────────────────────────────────
# ONE Telegram session, used only to resolve a track's file the first time somebody
# plays it and to stream bytes. There is no account pool any more: if this session is
# missing or flooded, crawling continues and resolved tracks keep playing.
# from https://my.telegram.org → API development tools
TG_API_ID=0
TG_API_HASH=replace-me
# encrypts the session at rest (≥16 chars; losing it means logging in again)
SESSION_ENC_KEY=replace-with-random-32-chars
SESSIONS_DIR=/data/sessions
# FloodWait at or above this marks the account "limited" (alert)
LIMITED_AFTER_S=900
# concurrent downloads from the one session
DOWNLOADS_MAX=8

# ── Deployment (compose files) ────────────────────────────────────────────────
DOMAIN=example.com
REGISTRY=ghcr.io/your-org
VERSION=latest
WG_CORE_IP=10.8.0.1
WG_EDGE_IP=10.8.0.2
EDGE_CACHE_SIZE=40g
API_REPLICAS=2
API_WORKERS=3
